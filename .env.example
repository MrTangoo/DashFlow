# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example with Neon: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nexdash?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/nexdash"

# NextAuth Configuration
# URL de votre application (http://localhost:3000 en développement)
NEXTAUTH_URL="http://localhost:3000"

# Secret pour signer les tokens JWT (générez avec: openssl rand -base64 32)
NEXTAUTH_SECRET="votre-secret-super-securise-genere-aleatoirement"

# GitHub OAuth (Optionnel)
# Obtenez vos credentials sur: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="votre-github-client-id"
GITHUB_SECRET="votre-github-client-secret"

# Weather API (Optionnel)
# Obtenez votre API key sur: https://openweathermap.org/api
OPENWEATHER_API_KEY="votre-api-key-openweather"
