generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // Optional for OAuth users
  name          String?
  emailVerified DateTime?
  image         String?   // URL or path to image
  imageData     Bytes?    // Binary image data (blob)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts   Account[]
  sessions   Session[]
  widgets    Widget[]
  tasks      Task[]
  notes      Note[]
  dailyData  DailyData[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Widget {
  id        String   @id @default(cuid())
  type      String   // "weather", "tasks", "notes", "stats", "github", "pomodoro", "waterTracker"
  x         Int
  y         Int
  w         Int
  h         Int
  visible   Boolean  @default(true)
  order     Int      @default(0)
  settings  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  date      String   // Date string (YYYY-MM-DD) for daily scoping
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyData {
  id           String   @id @default(cuid())
  userId       String
  date         String   // Date string (YYYY-MM-DD)
  waterBottles Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}
